---
import type { CollectionEntry } from 'astro:content';
import GitHubIcon from './GitHubIcon.astro';
import Icon from './Icon.astro';
import Tag from './Tag.astro';
import { Badge } from '@/components/ui/badge';
import { existingPublicImage } from '@/lib/files';
import { optimizedImage } from '@/lib/images';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { title, description, year, category, status, tags, links } = entry.data;
const image = existingPublicImage(entry.data.image);
const imageSrc = image ? await optimizedImage(image, { width: 640 }) : undefined;
const href = `/projects/${entry.id}`;
---

<div
  class="group relative flex flex-col bg-surface-light dark:bg-surface-dark border border-gray-200 dark:border-border-dark rounded-xl overflow-hidden hover:border-primary/50 transition-colors"
>
  <a href={href} class="absolute inset-0 z-10" aria-label={`View case study for ${title}`}></a>
  {
    imageSrc ? (
      <div class="h-48 relative pointer-events-none bg-gradient-to-br from-primary/10 to-blue-500/10 flex items-center justify-center p-6">
        <img
          class="max-h-full max-w-full object-contain transform group-hover:scale-105 transition-transform duration-500"
          src={imageSrc}
          alt={title}
          loading="lazy"
        />
      </div>
    ) : (
      <div class="h-24 relative pointer-events-none bg-gradient-to-br from-primary/20 to-blue-500/20 flex items-center justify-center">
        <Icon name="folder" class="text-5xl text-primary/40" />
      </div>
    )
  }
  <div class="flex flex-col flex-1 p-5 gap-4 pointer-events-none">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1">
        <h3 class="text-gray-900 dark:text-white text-xl font-bold mb-1 group-hover:text-primary transition-colors pointer-events-auto">
          <a href={href} class="hover:underline">{title}</a>
        </h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 font-mono">{category} · {year}</p>
      </div>
      {
        links.code && (
          <a
            href={links.code}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 dark:text-gray-400 hover:text-primary transition-colors flex-shrink-0 pointer-events-auto relative z-20"
            aria-label="View on GitHub"
          >
            <GitHubIcon class="w-10 h-10" />
          </a>
        )
      }
    </div>
    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed line-clamp-3">{description}</p>
    <div class="mt-auto flex flex-wrap gap-2">
      <Badge
        variant={status === 'On-going' ? 'info-light' : 'success-light'}
        className="text-[10px] font-bold uppercase tracking-wider px-2 py-1 h-auto min-w-0 rounded"
      >
        {status}
      </Badge>
      {tags.map((tag) => <Tag>{tag}</Tag>)}
    </div>
  </div>
</div>
