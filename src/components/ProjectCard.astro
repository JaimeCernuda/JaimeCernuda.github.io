---
import type { CollectionEntry } from 'astro:content';
import GitHubIcon from './GitHubIcon.astro';
import Icon from './Icon.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { title, description, year, category, status, tags, links, image } = entry.data;
const href = `/projects/${entry.id}`;
---

<div
  class="group relative flex flex-col bg-surface-light dark:bg-surface-dark border border-gray-200 dark:border-border-dark rounded-xl overflow-hidden hover:border-primary/50 transition-colors"
>
  <a href={href} class="absolute inset-0 z-10" aria-label={`View case study for ${title}`}></a>
  <div class="h-48 overflow-hidden relative pointer-events-none">
    {
      image ? (
        <>
          <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors z-10" />
          <img
            class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500"
            src={image}
            alt={title}
            loading="lazy"
          />
        </>
      ) : (
        <div class="h-full w-full flex items-center justify-center bg-gray-100 dark:bg-surface-dark-lighter">
          <Icon name="folder" class="text-6xl text-gray-300 dark:text-gray-600" />
        </div>
      )
    }
  </div>
  <div class="flex flex-col flex-1 p-5 gap-4 pointer-events-none">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1">
        <h3 class="text-gray-900 dark:text-white text-xl font-bold mb-1 group-hover:text-primary transition-colors pointer-events-auto">
          <a href={href} class="hover:underline">{title}</a>
        </h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 font-mono">{category} · {year}</p>
      </div>
      {
        links.code && (
          <a
            href={links.code}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-600 dark:text-gray-400 hover:text-primary transition-colors flex-shrink-0 pointer-events-auto relative z-20"
            aria-label="View on GitHub"
          >
            <GitHubIcon class="w-10 h-10" />
          </a>
        )
      }
    </div>
    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed line-clamp-3">{description}</p>
    <div class="mt-auto flex flex-wrap gap-2">
      <span
        class:list={[
          'text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded',
          status === 'On-going'
            ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300'
            : 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300',
        ]}
      >
        {status}
      </span>
      {
        tags.map((tag) => (
          <span class="text-[10px] font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-surface-dark-lighter px-2 py-1 rounded border border-gray-200 dark:border-border-dark">
            {tag}
          </span>
        ))
      }
    </div>
  </div>
</div>
