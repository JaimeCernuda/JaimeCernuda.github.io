---
/**
 * Site mark: the "JC" interlock monogram, rebuilt as vector geometry from the
 * design sheet. Fill follows `currentColor`, so color it with a text utility.
 * The two masks cut hairline gaps where the strokes cross: the J passes in
 * front of the C at the top, the C in front of the J at the hook.
 */
interface Props {
  class?: string;
}
const { class: className = 'h-8 w-auto' } = Astro.props;

const J = 'M100 35A35 35 0 0 1 135 0H170V240A85 85 0 0 1 0 240V175H70V240A15 15 0 0 0 100 240Z';
const C = 'M346.65 163A110 110 0 1 0 346.65 247H272.13A50 50 0 1 1 272.13 163Z';
---

<svg class={className} viewBox="-6 -6 367 342" role="img" aria-label="Jaime Cernuda" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <clipPath id="jc-top"><rect x="-20" y="-20" width="420" height="210"></rect></clipPath>
    <clipPath id="jc-bottom"><rect x="-20" y="190" width="420" height="220"></rect></clipPath>
    <mask id="jc-mc" maskUnits="userSpaceOnUse" x="-20" y="-20" width="420" height="400">
      <rect x="-20" y="-20" width="420" height="400" fill="#fff"></rect>
      <path d={J} fill="#000" stroke="#000" stroke-width="9" clip-path="url(#jc-top)"></path>
    </mask>
    <mask id="jc-mj" maskUnits="userSpaceOnUse" x="-20" y="-20" width="420" height="400">
      <rect x="-20" y="-20" width="420" height="400" fill="#fff"></rect>
      <path d={C} fill="#000" stroke="#000" stroke-width="9" clip-path="url(#jc-bottom)"></path>
    </mask>
  </defs>
  <path d={C} fill="currentColor" mask="url(#jc-mc)"></path>
  <path d={J} fill="currentColor" mask="url(#jc-mj)"></path>
</svg>
