---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate } from '@/lib/dates';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, summary, date, category, readTime } = post.data;
const href = `/blog/${post.id}`;
---

<article
  class="relative flex flex-col gap-4 p-6 rounded-2xl bg-white dark:bg-surface-dark border border-gray-100 dark:border-gray-800 hover:border-primary/30 dark:hover:border-primary/30 hover:shadow-lg transition-all group"
>
  <a href={href} class="absolute inset-0 z-10" aria-label={`Read ${title}`}></a>
  <div class="flex items-center gap-3 text-xs md:text-sm text-gray-500 dark:text-gray-400 relative z-20 pointer-events-none">
    <div class="flex items-center gap-1">
      <Icon name="calendar_today" class="text-[16px]" />
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    </div>
    <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
    <div class="flex items-center gap-1 text-primary font-bold uppercase tracking-wide text-xs">{category}</div>
    <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
    <span>{readTime}</span>
  </div>
  <a href={href} class="group-hover:text-primary transition-colors relative z-20">
    <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white leading-tight">{title}</h3>
  </a>
  <p class="text-base text-gray-600 dark:text-gray-300 leading-relaxed line-clamp-3 relative z-20 pointer-events-none">{summary}</p>
  <a href={href} class="inline-flex items-center gap-1 text-primary font-bold text-sm hover:underline mt-2 relative z-20">
    Read full article <Icon name="arrow_forward" class="text-[16px]" />
  </a>
</article>
