---
import { yearOf } from '@/lib/dates';

interface Item {
  date: string;
  title: string;
  description: string;
  link: string;
}
interface Props {
  items: Item[];
  /** "compact" is the home page column, "full" is the news archive. */
  variant?: 'compact' | 'full';
}
const { items, variant = 'full' } = Astro.props;

let lastYear: string | null = null;
const rows = items.map((item) => {
  const year = yearOf(item.date);
  const showYear = Boolean(year) && year !== lastYear;
  if (year) lastYear = year;
  return { item, year, showYear };
});
const linked = (item: Item) => item.link && item.link !== '#';
---

{
  variant === 'compact' ? (
    <div class="flex flex-col gap-6 relative">
      <div class="absolute left-[7px] top-2 bottom-2 w-px bg-gray-200 dark:bg-gray-800" />
      {rows.map(({ item, year, showYear }) => (
        <>
          {showYear && (
            <div class="relative pl-6 flex items-center gap-3 mb-2 mt-2 first:mt-0">
              <span class="text-xs font-bold text-gray-400 dark:text-gray-500">{year}</span>
              <div class="h-px bg-gray-200 dark:bg-gray-800 flex-1" />
            </div>
          )}
          <div class="relative pl-6">
            <div class="absolute left-0 top-1.5 w-3.5 h-3.5 bg-white dark:bg-surface-dark border-2 border-primary rounded-full z-10" />
            <span class="text-xs font-bold text-gray-500 dark:text-gray-400 mb-1 block uppercase tracking-wider">{item.date}</span>
            <h4 class="text-sm font-bold text-gray-900 dark:text-white mb-1 leading-tight">
              {linked(item) ? (
                <a href={item.link} class="hover:text-primary transition-colors">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h4>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed">{item.description}</p>
          </div>
        </>
      ))}
    </div>
  ) : (
    <div class="relative border-l-2 border-gray-200 dark:border-gray-800 ml-3 md:ml-6 space-y-12">
      {rows.map(({ item, year, showYear }) => (
        <>
          {showYear && (
            <div class="relative pl-8 md:pl-12 pt-4">
              <span class="text-2xl font-bold text-gray-900 dark:text-white">{year}</span>
            </div>
          )}
          <div class="relative pl-8 md:pl-12">
            <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-white dark:bg-surface-dark border-4 border-primary rounded-full" />
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4 mb-2">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white">
                {linked(item) ? (
                  <a href={item.link} class="hover:text-primary transition-colors">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </h3>
              <span class="text-sm font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wide shrink-0">{item.date}</span>
            </div>
            <p class="text-base text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">{item.description}</p>
          </div>
        </>
      ))}
    </div>
  )
}
