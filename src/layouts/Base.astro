---
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { cleanPath } from '@/lib/urls';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  /** Route path without .html. Defaults to the current URL. */
  path?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, type, image, path, jsonLd } = Astro.props;
const currentPath = path ?? cleanPath(Astro.url.pathname);
const isHome = currentPath === '/';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Light is the default. Apply dark before paint only when the visitor
      // chose it earlier with the toggle.
      (function () {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
    <SEO
      title={title}
      description={description}
      type={type}
      image={image}
      path={currentPath}
      jsonLd={jsonLd}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Jaime Cernuda" href="/rss.xml" />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/material-symbols-outlined-subset.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="min-h-screen flex flex-col font-display selection:bg-primary/30 selection:text-white">
      <Navbar currentPath={currentPath} />
      <main class="flex-1 flex flex-col w-full">
        <slot />
      </main>
      <Footer isHome={isHome} />
    </div>
  </body>
</html>
