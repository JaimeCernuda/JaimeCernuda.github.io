---
import { getCollection, getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import CiteButton from '@/components/islands/CiteButton';
import { Frame, FramePanel } from '@/components/ui/frame';
import { groupByYear, publicationDescription } from '@/lib/content';

const page = await getEntry('pages', 'publications');
if (!page) throw new Error('src/content/pages/publications.yaml is missing');
const { header } = page.data;

const all = await getCollection('publications');
const featured = all.find((p) => p.data.featured);
const groups = groupByYear(all);
const years = groups.map(([year]) => year);
const buttonClass =
  'flex items-center justify-center gap-2 rounded-lg h-10 px-5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white text-sm font-bold transition-colors';
---

<Base title={header.title} description={header.subtitle} path="/publications">
  <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-2xl">
      <h1 class="text-4xl md:text-5xl font-black leading-tight tracking-[-0.033em] text-gray-900 dark:text-white">
        {header.title}
      </h1>
      <p class="text-gray-600 dark:text-gray-400 text-lg font-normal leading-normal">{header.subtitle}</p>
    </div>

    {
      featured && (
        <Frame className="[--frame-radius:var(--radius-2xl)]">
          <FramePanel className="p-0! flex flex-col items-stretch justify-start shadow-lg bg-white dark:bg-surface-dark border-gray-100 dark:border-gray-800 group hover:border-primary/50 transition-colors">
          <a href={`/publications/${featured.id}`} class="absolute inset-0 z-10" aria-label={`Read ${featured.data.title}`} />
          <div class="flex flex-col lg:flex-row relative z-20 pointer-events-none">
            <div class="w-full lg:w-2/5 h-64 lg:h-auto bg-gradient-to-br from-primary/20 to-blue-500/20 flex items-center justify-center p-8 relative">
              <div class="absolute top-4 left-4 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">
                Featured Paper
              </div>
              <Icon name="article" class="text-9xl text-primary/40" />
            </div>
            <div class="flex w-full lg:w-3/5 flex-col justify-center gap-4 p-6 lg:p-8">
              <div class="flex items-center gap-2">
                <span class="text-primary font-bold text-sm">{featured.data.venue}</span>
                <span class="text-gray-400 text-sm">•</span>
                <span class="text-gray-500 text-sm">{featured.data.year}</span>
              </div>
              <a href={`/publications/${featured.id}`} class="pointer-events-auto">
                <h2 class="text-2xl md:text-3xl font-bold leading-tight text-gray-900 dark:text-white group-hover:text-primary transition-colors">
                  {featured.data.title}
                </h2>
              </a>
              <p class="text-gray-600 dark:text-gray-300 text-base leading-relaxed line-clamp-3">
                {publicationDescription(featured)}
              </p>
              <div class="flex flex-wrap gap-3 mt-2 pointer-events-auto">
                <a
                  href={`/publications/${featured.id}`}
                  class="flex items-center justify-center gap-2 rounded-lg h-10 px-5 bg-primary hover:bg-blue-600 text-white text-sm font-bold transition-colors shadow-sm shadow-primary/30"
                >
                  <span>Read Paper</span>
                </a>
                {featured.data.links.pdf && (
                  <a href={featured.data.links.pdf} target="_blank" rel="noopener noreferrer" class={buttonClass}>
                    <Icon name="description" class="text-[18px]" />
                    <span>PDF</span>
                  </a>
                )}
                <CiteButton client:visible citation={featured.data.citation} label="Cite" className={`${buttonClass} cursor-pointer`} />
              </div>
            </div>
          </div>
          </FramePanel>
        </Frame>
      )
    }

    <nav class="flex flex-wrap items-center gap-2" aria-label="Jump to year">
      <span class="text-sm font-medium text-gray-500 dark:text-gray-400 mr-1">Year</span>
      {
        years.map((year) => (
          <a
            href={`#year-${year}`}
            class="h-10 px-3 inline-flex items-center rounded-lg bg-white dark:bg-surface-dark border border-gray-200 dark:border-gray-700 text-sm font-medium hover:border-primary/50 hover:text-primary transition-colors"
          >
            {year}
          </a>
        ))
      }
      <span class="text-sm text-gray-500 dark:text-gray-400 ml-auto">{all.length} publications</span>
    </nav>

    {
      groups.map(([year, entries]) => (
        <section id={`year-${year}`} class="scroll-mt-24 flex flex-col gap-6">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
            {year}
            <span class="text-sm font-medium text-gray-500 dark:text-gray-400">{entries.length}</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {entries.map((entry) => (
              <PublicationCard entry={entry} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
