---
import { getCollection, getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import Icon from '@/components/Icon.astro';
import CiteButton from '@/components/islands/CiteButton';
import CopyToClipboard from '@/components/islands/CopyToClipboard';
import { Frame, FramePanel } from '@/components/ui/frame';
import { sortByYear } from '@/lib/content';
import { optimizedImage } from '@/lib/images';

const cv = await getEntry('cv', 'cv');
if (!cv) throw new Error('src/content/site/cv.yaml is missing');
const { profile, summary, page_subtitle, education, experience, skills, awards } = cv.data;
const publications = sortByYear(await getCollection('publications'));
const avatar = await optimizedImage(profile.image, { width: 256 });

const websiteHref = /^https?:\/\//.test(profile.website) ? profile.website : `https://${profile.website}`;
const sections = ['summary', 'education', 'experience', 'publications', 'skills', 'awards'];
const rowLink = 'text-xs font-bold text-gray-500 hover:text-primary transition-colors flex items-center gap-1';
---

<Base title="Curriculum Vitae" description={summary} type="profile" path="/cv">
  <div class="flex-grow w-full max-w-[1600px] mx-auto p-4 sm:p-6 lg:p-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 relative">
      <aside class="lg:col-span-4 xl:col-span-3 lg:sticky lg:top-24 h-fit max-h-[calc(100vh-8rem)] overflow-y-auto overflow-x-hidden space-y-6">
        <Frame>
          <FramePanel className="p-6 overflow-visible bg-surface-light dark:bg-surface-dark border-gray-200 dark:border-border-dark transition-colors">
          <div class="flex flex-col items-center text-center">
            <div class="relative w-32 h-32 mb-4 group">
              <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-primary to-blue-400 opacity-20 blur-sm group-hover:opacity-30 transition-opacity"></div>
              <img
                class="w-full h-full object-cover rounded-full border-4 border-white dark:border-surface-dark relative z-10"
                src={avatar}
                alt={profile.name}
                width="128"
                height="128"
              />
            </div>
            <h1 class="text-xl font-bold text-gray-900 dark:text-white mb-1">{profile.name}</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm mb-4 whitespace-pre-line">{profile.title}</p>
            <div class="w-full space-y-3 mb-6">
              <CopyToClipboard
                client:visible
                text={profile.email}
                icon="mail"
                iconClassName="text-[20px]"
                label={profile.email}
                className="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors cursor-pointer w-full justify-center"
              />
              <a href={websiteHref} class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors justify-center">
                <Icon name="language" class="text-[20px]" />
                {profile.website}
              </a>
              <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400 justify-center">
                <Icon name="location_on" class="text-[20px]" />
                {profile.location}
              </div>
            </div>
            <a
              href="/cv/CV_Jaime_latest.pdf"
              download
              class="w-full flex items-center justify-center gap-2 bg-primary hover:bg-blue-700 text-white py-2.5 px-4 rounded-lg font-medium transition-colors shadow-lg shadow-blue-500/20"
            >
              <Icon name="download" class="text-[20px]" />
              Download PDF CV
            </a>
          </div>
          </FramePanel>
        </Frame>

        <div class="bg-surface-light dark:bg-surface-dark rounded-xl p-6 shadow-sm border border-gray-200 dark:border-border-dark hidden lg:block transition-colors sticky top-24">
          <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-4">On this page</h3>
          <nav class="space-y-2 text-sm border-l border-gray-200 dark:border-gray-800" aria-label="CV sections">
            {
              sections.map((section) => (
                <a
                  href={`#${section}`}
                  class="block pl-4 py-1 border-l-2 -ml-[2px] transition-colors capitalize border-transparent text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-200"
                >
                  {section}
                </a>
              ))
            }
          </nav>
        </div>
      </aside>

      <div class="lg:col-span-8 xl:col-span-9 space-y-8 pb-20">
        <div class="flex flex-col gap-2">
          <h2 class="text-4xl md:text-5xl font-black tracking-tight text-gray-900 dark:text-white">Curriculum Vitae</h2>
          {page_subtitle && <p class="text-lg text-gray-500 dark:text-gray-400 font-light">{page_subtitle}</p>}
        </div>

        <section id="summary" class="scroll-mt-[96px] bg-surface-light dark:bg-surface-dark rounded-xl p-6 md:p-8 shadow-sm border border-gray-200 dark:border-border-dark transition-colors">
          <div class="flex items-center gap-3 mb-4">
            <div class="p-2 rounded-lg bg-primary/10 text-primary"><Icon name="person" /></div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">Professional Summary</h2>
          </div>
          <p class="text-gray-900 dark:text-gray-300 leading-relaxed">{summary}</p>
        </section>

        <section id="education" class="scroll-mt-[96px]">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary"><Icon name="school" /></div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">Education</h2>
          </div>
          <div class="relative space-y-8 pl-8 before:content-[''] before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-[2px] before:bg-gray-200 dark:before:bg-gray-700">
            {
              education.map((edu, index) => (
                <div class="relative">
                  <div
                    class:list={[
                      'absolute -left-[39px] top-1.5 size-4 rounded-full border-4 border-white dark:border-background-dark shadow-sm',
                      index === 0 ? 'bg-primary' : 'bg-gray-300 dark:bg-gray-600',
                    ]}
                  />
                  <div class="bg-surface-light dark:bg-surface-dark p-5 rounded-lg border border-gray-200 dark:border-border-dark shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 mb-2">
                      <div>
                        <h3 class="font-bold text-lg text-gray-900 dark:text-white">{edu.degree}</h3>
                        <p class="text-primary font-medium">{edu.school}</p>
                      </div>
                      <span class="inline-flex items-center shrink-0 whitespace-nowrap px-2.5 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">{edu.year}</span>
                    </div>
                    {edu.details.map((detail) => (
                      <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">{detail}</p>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section id="experience" class="scroll-mt-[96px]">
          <div class="flex items-center gap-3 mb-6">
            <div class="p-2 rounded-lg bg-primary/10 text-primary"><Icon name="work" /></div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">Experience</h2>
          </div>
          <div class="relative space-y-8 pl-8 before:content-[''] before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-[2px] before:bg-gray-200 dark:before:bg-gray-700">
            {
              experience.map((exp, index) => (
                <div class="relative">
                  <div
                    class:list={[
                      'absolute -left-[39px] top-1.5 size-4 rounded-full border-4 border-white dark:border-background-dark shadow-sm',
                      index === 0 ? 'bg-primary' : 'bg-gray-300 dark:bg-gray-600',
                    ]}
                  />
                  <div class="bg-surface-light dark:bg-surface-dark p-5 rounded-lg border border-gray-200 dark:border-border-dark shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 mb-3">
                      <div>
                        <h3 class="font-bold text-lg text-gray-900 dark:text-white">{exp.role}</h3>
                        <p class="text-primary font-medium">{exp.company}</p>
                      </div>
                      <span class="inline-flex items-center shrink-0 whitespace-nowrap px-2.5 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">{exp.year}</span>
                    </div>
                    <ul class="list-disc list-outside ml-5 space-y-1 text-sm text-gray-500 dark:text-gray-400">
                      {exp.details.map((detail) => (
                        <li>{detail}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section id="publications" class="scroll-mt-[96px]">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-primary/10 text-primary"><Icon name="article" /></div>
              <h2 class="text-xl font-bold text-gray-900 dark:text-white">Publications</h2>
            </div>
          </div>
          <div class="space-y-4">
            {
              publications.map((pub) => (
                <div class="group relative bg-surface-light dark:bg-surface-dark p-5 rounded-lg border border-gray-200 dark:border-border-dark shadow-sm hover:border-primary/30 transition-all">
                  <a href={`/publications/${pub.id}`} class="absolute inset-0 z-10" aria-label={`View details for ${pub.data.title}`} />
                  <div class="flex flex-col sm:flex-row justify-between items-start gap-4 relative z-20 pointer-events-none">
                    <div>
                      <h3 class="font-bold text-base text-gray-900 dark:text-white group-hover:text-primary transition-colors pointer-events-auto">
                        <a href={`/publications/${pub.id}`}>{pub.data.title}</a>
                      </h3>
                      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{pub.data.authors}</p>
                      <p class="text-sm text-gray-500 dark:text-gray-400 italic mt-0.5">
                        <span class="font-semibold not-italic">{pub.data.type} • </span>
                        {pub.data.venue} • {pub.data.year}
                      </p>
                    </div>
                    <div class="grid grid-cols-2 gap-3 w-fit shrink-0 pointer-events-auto">
                      <a href={`/publications/${pub.id}`} class={rowLink}>
                        <span class="w-5 inline-flex justify-center items-center"><Icon name="article" class="text-[18px]" /></span> Read Paper
                      </a>
                      {pub.data.links.pdf && (
                        <a href={pub.data.links.pdf} target="_blank" rel="noopener noreferrer" class={rowLink}>
                          <span class="w-5 inline-flex justify-center items-center"><Icon name="description" class="text-[18px]" /></span> PDF
                        </a>
                      )}
                      {pub.data.links.code && (
                        <a href={pub.data.links.code} target="_blank" rel="noopener noreferrer" class={rowLink}>
                          <span class="w-5 inline-flex justify-center items-center"><GitHubIcon class="w-[18px] h-[18px]" /></span> Code
                        </a>
                      )}
                      <CiteButton client:visible citation={pub.data.citation} label="Cite" wrapIcon className={`${rowLink} cursor-pointer`} />
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <section id="skills" class="scroll-mt-[96px]">
            <div class="flex items-center gap-3 mb-6">
              <div class="p-2 rounded-lg bg-primary/10 text-primary"><Icon name="code" /></div>
              <h2 class="text-xl font-bold text-gray-900 dark:text-white">Skills</h2>
            </div>
            <div class="bg-surface-light dark:bg-surface-dark p-6 rounded-xl border border-gray-200 dark:border-border-dark shadow-sm">
              <h3 class="text-sm font-bold text-gray-500 dark:text-gray-400 mb-3 uppercase tracking-wider">Languages</h3>
              <div class="flex flex-wrap gap-2 mb-6">
                {skills.languages.map((skill) => <span class="px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-gray-200 text-sm font-medium">{skill}</span>)}
              </div>
              <h3 class="text-sm font-bold text-gray-500 dark:text-gray-400 mb-3 uppercase tracking-wider">Frameworks &amp; Tools</h3>
              <div class="flex flex-wrap gap-2">
                {skills.tools.map((skill) => <span class="px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/20 text-primary text-sm font-medium border border-blue-100 dark:border-blue-800">{skill}</span>)}
              </div>
              {
                skills.spoken.length > 0 && (
                  <>
                    <h3 class="text-sm font-bold text-gray-500 dark:text-gray-400 mb-3 mt-6 uppercase tracking-wider">Languages Spoken</h3>
                    <div class="flex flex-wrap gap-2">
                      {skills.spoken.map((skill) => (
                        <span class="px-3 py-1 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-gray-200 text-sm font-medium">{skill}</span>
                      ))}
                    </div>
                  </>
                )
              }
            </div>
          </section>

          <section id="awards" class="scroll-mt-[96px]">
            <div class="flex items-center gap-3 mb-6">
              <div class="p-2 rounded-lg bg-primary/10 text-primary"><Icon name="emoji_events" /></div>
              <h2 class="text-xl font-bold text-gray-900 dark:text-white">Awards &amp; Honors</h2>
            </div>
            <div class="bg-surface-light dark:bg-surface-dark p-6 rounded-xl border border-gray-200 dark:border-border-dark shadow-sm">
              {
                awards.length > 0 ? (
                  <ul class="space-y-4">
                    {awards.map((award) => (
                      <li class="flex gap-3">
                        <Icon name="star" class="text-yellow-500 shrink-0" />
                        <div>
                          <p class="font-bold text-gray-900 dark:text-white text-sm">{award.title}</p>
                          <p class="text-xs text-gray-500 dark:text-gray-400">{award.venue ?? award.year}</p>
                        </div>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-sm text-gray-500 dark:text-gray-400">No awards listed yet.</p>
                )
              }
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</Base>
