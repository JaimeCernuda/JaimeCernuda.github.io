---
import { getCollection, getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { Badge } from '@/components/ui/badge';
import { Frame, FramePanel } from '@/components/ui/frame';
import { sortByYear } from '@/lib/content';
import { existingPublicImage } from '@/lib/files';
import { optimizedImage } from '@/lib/images';

const page = await getEntry('pages', 'projects');
if (!page) throw new Error('src/content/pages/projects.yaml is missing');
const { header } = page.data;

const all = sortByYear(await getCollection('projects'));
const featured = all.find((p) => p.data.featured);
const rest = all.filter((p) => p !== featured);
const featuredImage = existingPublicImage(featured?.data.image);
const featuredImageSrc = featuredImage ? await optimizedImage(featuredImage, { width: 800 }) : undefined;
---

<Base title={header.title} description={header.subtitle} path="/projects">
  <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-2xl">
      <h1 class="text-4xl md:text-5xl font-black leading-tight tracking-[-0.033em] text-gray-900 dark:text-white">{header.title}</h1>
      <p class="text-gray-600 dark:text-gray-400 text-lg font-normal leading-normal">{header.subtitle}</p>
    </div>

    {
      featured && (
        <Frame className="[--frame-radius:var(--radius-2xl)]">
          <FramePanel className="p-0! flex flex-col items-stretch justify-start shadow-lg bg-white dark:bg-surface-dark border-gray-100 dark:border-gray-800 group hover:border-primary/50 transition-colors">
          <a href={`/projects/${featured.id}`} class="absolute inset-0 z-10" aria-label={`View ${featured.data.title}`} />
          <div class="flex flex-col lg:flex-row relative z-20 pointer-events-none">
            <div
              class="w-full lg:w-2/5 h-56 lg:h-auto lg:min-h-[16rem] relative flex items-center justify-center p-8 bg-gradient-to-br from-primary/10 to-blue-500/10"
            >
              {featuredImageSrc ? (
                <img class="max-h-40 lg:max-h-56 max-w-full object-contain" src={featuredImageSrc} alt={featured.data.title} />
              ) : (
                <Icon name="folder" class="text-8xl text-primary/40" />
              )}
              <div class="absolute top-4 left-4 bg-primary text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">Featured Project</div>
            </div>
            <div class="flex w-full lg:w-3/5 flex-col justify-center gap-4 p-6 lg:p-8">
              <div class="flex items-center gap-2">
                <span class="text-gray-500 dark:text-gray-400 text-xs font-medium">{featured.data.category} · {featured.data.year}</span>
              </div>
              <div class="flex items-center justify-between gap-4">
                <h2 class="text-2xl md:text-3xl font-bold leading-tight text-gray-900 dark:text-white">
                  <a href={`/projects/${featured.id}`} class="group-hover:text-primary transition-colors pointer-events-auto">
                    {featured.data.title}
                  </a>
                </h2>
                {featured.data.links.code && (
                  <a
                    href={featured.data.links.code}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-gray-600 dark:text-gray-400 hover:text-primary transition-colors flex-shrink-0 pointer-events-auto"
                    aria-label="View on GitHub"
                  >
                    <GitHubIcon class="w-8 h-8" />
                  </a>
                )}
              </div>
              <p class="text-gray-600 dark:text-gray-300 text-base leading-relaxed">{featured.data.description}</p>
              <div class="flex flex-wrap gap-2 mb-2">
                <Badge
                  variant={featured.data.status === 'On-going' ? 'info-light' : 'success-light'}
                  className="text-xs font-bold uppercase tracking-wider px-2 py-1 h-auto rounded"
                >
                  {featured.data.status}
                </Badge>
                {featured.data.tags.map((tag) => (
                  <Badge
                    variant="outline"
                    className="text-xs font-medium text-gray-500 dark:text-gray-300 bg-gray-100 dark:bg-surface-dark-lighter px-2 py-1 h-auto rounded border-gray-200 dark:border-border-dark"
                  >
                    {tag}
                  </Badge>
                ))}
              </div>
              <div class="flex flex-wrap gap-3 mt-2 pointer-events-auto">
                {featured.data.links.website && (
                  <a
                    href={featured.data.links.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-gray-600 dark:text-gray-400 hover:text-primary transition-colors flex items-center gap-1"
                    aria-label="Project Website"
                  >
                    <Icon name="language" class="text-[20px]" />
                    <span class="text-sm font-bold">Project Website</span>
                  </a>
                )}
              </div>
            </div>
          </div>
          </FramePanel>
        </Frame>
      )
    }

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {rest.map((entry) => <ProjectCard entry={entry} />)}
    </div>
  </div>
</Base>
