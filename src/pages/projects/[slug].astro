---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import GitHubIcon from '@/components/GitHubIcon.astro';
import Icon from '@/components/Icon.astro';
import Prose from '@/components/Prose.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { Badge } from '@/components/ui/badge';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, description, year, category, tags, links } = entry.data;
const { Content, headings } = await render(entry);
const hasHeadings = headings.some((h) => h.depth <= 3);
const path = `/projects/${entry.id}`;
---

<Base title={title} description={description} type="article" path={path}>
  <div id="top" class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <a href="/projects" class="inline-flex items-center gap-2 text-primary font-bold hover:underline mb-6">
      <Icon name="arrow_back" class="text-sm" />
      Back to Projects
    </a>

    <div class="flex flex-col xl:flex-row gap-12 items-start">
      <TableOfContents headings={headings} title={title} />

      <article class:list={['max-w-3xl mx-auto w-full', hasHeadings && 'xl:mx-0']}>
        <div class="mb-8">
          <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400 mb-3">
            <span class="bg-primary/10 text-primary px-2 py-1 rounded font-bold text-xs uppercase tracking-wide">{category}</span>
            <span>•</span>
            <span>{year}</span>
          </div>
          <h1 class="text-3xl md:text-5xl font-black text-gray-900 dark:text-white leading-tight mb-4">{title}</h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed mb-6">{description}</p>
          <div class="flex flex-wrap gap-2 mb-6">
            {
              tags.map((tag) => (
                <Badge
                  variant="outline"
                  className="text-xs font-medium text-gray-500 dark:text-gray-300 bg-gray-100 dark:bg-surface-dark-lighter px-2 py-1 h-auto rounded border-gray-200 dark:border-border-dark"
                >
                  {tag}
                </Badge>
              ))
            }
          </div>

          <div class="flex flex-wrap gap-4">
            {
              links.website && (
                <a href={links.website} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-5 py-2.5 bg-primary hover:bg-blue-600 text-white rounded-lg font-bold transition-colors shadow-sm shadow-primary/30 text-base">
                  <Icon name="language" />
                  Project Website
                </a>
              )
            }
            {
              links.code && (
                <a href={links.code} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-900 dark:text-white rounded-lg font-bold transition-colors text-base">
                  <GitHubIcon class="w-5 h-5" />
                  View Code
                </a>
              )
            }
          </div>
        </div>

        <div class="w-full h-px bg-gray-200 dark:bg-gray-800 my-8"></div>

        <Prose>
          <Content />
        </Prose>
      </article>
    </div>
  </div>
</Base>
